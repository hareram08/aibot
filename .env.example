# Copy to ".env" for local testing. NEVER commit .env or paste the key into any .html/.js file.
# In production, set these in Vercel: Project > Settings > Environment Variables.

# Set ONE of the two provider keys below (Gemini is used if both are set).

# Gemini. Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Model used for answers (default: gemini-3.8-flash).
GEMINI_MODEL=gemini-3.8-flash

# OpenAI (alternative provider). Create at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Model used for answers (default: gpt-4.1-mini). Check the name is still
# offered on OpenAI's models page before changing it.
OPENAI_MODEL=gpt-4.1-mini

# Optional. Rate limits per visitor IP address.
CHAT_RATE_LIMIT_PER_MINUTE=8
CHAT_RATE_LIMIT_PER_DAY=80

# Optional. Extra sites allowed to call /api/chat, comma separated. Leave empty:
# the site that serves the function is always allowed.
ALLOWED_ORIGINS=
